# Скопируйте в .env и при необходимости измените значения
POSTGRES_DB=electroncash
POSTGRES_USER=electroncash
POSTGRES_PASSWORD=electroncash
POSTGRES_PORT=5432

API_PORT=8000
JWT_SECRET=change-me-in-production

ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin

# Каталог для файлов изображений товаров (внутри контейнера api)
IMAGE_DIR=/data/images
# Максимальный размер изображения при импорте/загрузке, байт
IMAGE_MAX_BYTES=10485760
# Удалять изображение товара, когда он распродан (stock = 0)
DELETE_IMAGES_WHEN_OUT_OF_STOCK=true
